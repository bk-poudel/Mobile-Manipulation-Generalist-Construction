<mujoco model="ur10e_sanding_scene">
  <include file="ur10e_sander.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.2 0.2 0.2" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.05 0.05 0.1" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.25 0.28 0.32" rgb2="0.18 0.20 0.24"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.15"/>

    <!-- Tall Wall Materials -->
    <material name="wood_wall" rgba="0.78 0.66 0.52 1" specular="0.15" shininess="0.1"/>
    <material name="frame_steel" rgba="0.22 0.24 0.26 1" specular="0.6" shininess="0.4"/>
    <material name="sanding_zone" rgba="0.85 0.75 0.62 1" specular="0.2" shininess="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 -1.2 2.2" dir="0 0.8 -0.6" diffuse="0.8 0.8 0.8"/>
    <light pos="0 1.2 2.5" dir="0 -0.6 -0.8" diffuse="0.6 0.6 0.6"/>
    <light pos="-0.15 0.4 1.2" dir="0 1 -0.5" directional="false" diffuse="0.9 0.9 0.9" specular="0.3 0.3 0.3"/>
    
    <!-- Floor plane -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Fixed Tall Wall Cuboid in Front of Robot -->
    <!-- Front surface is positioned at Y = 0.8000 m -->
    <body name="tall_wall_assembly" pos="-0.15 0.85 0.7">
      <!-- Main wooden wall cuboid (1.4m tall, 0.8m wide, 0.1m thick) -->
      <geom name="tall_wall" type="box" size="0.4 0.05 0.7" material="wood_wall"
            solref="0.02 1.0" solimp="0.01 0.95 0.005 0.5 2" friction="0.04 0.005 0.0001"/>
      
      <!-- Visual Sanding Target Zone on the wall surface -->
      <geom name="sanding_target_patch" type="box" pos="0 -0.0505 0" size="0.15 0.001 0.1" material="sanding_zone"
            contype="0" conaffinity="0"/>

      <!-- Structural steel support posts and base feet for industrial realism -->
      <geom name="post_left" type="box" pos="-0.42 0 0" size="0.02 0.06 0.7" material="frame_steel" contype="0" conaffinity="0"/>
      <geom name="post_right" type="box" pos="0.42 0 0" size="0.02 0.06 0.7" material="frame_steel" contype="0" conaffinity="0"/>
      <geom name="foot_left" type="box" pos="-0.42 0 -0.68" size="0.03 0.25 0.02" material="frame_steel" contype="0" conaffinity="0"/>
      <geom name="foot_right" type="box" pos="0.42 0 -0.68" size="0.03 0.25 0.02" material="frame_steel" contype="0" conaffinity="0"/>
      <geom name="top_cap" type="box" pos="0 0 0.71" size="0.44 0.06 0.015" material="frame_steel" contype="0" conaffinity="0"/>
    </body>

    <!-- Fixed Cameras -->
    <camera name="sanding_view" pos="0.9 0.3 1.2" xyaxes="0.5 0.86 0 -0.25 0.15 0.95"/>
    <camera name="closeup_view" pos="0.35 0.65 0.75" xyaxes="0.38 0.92 0 -0.2 0.08 0.97"/>
    <camera name="side_view" pos="1.2 0.80 0.70" xyaxes="0 1 0 0 0 1"/>
    <camera name="top_down" pos="-0.15 0.45 1.7" xyaxes="1 0 0 0 0.6 -0.8"/>
  </worldbody>
</mujoco>
