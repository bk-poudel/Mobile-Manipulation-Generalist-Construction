<mujoco model="husky_ur10e_scene">
  <include file="husky_ur10e.xml"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.25 0.25 0.25" specular="0.15 0.15 0.15"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.05 0.05 0.1" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.25 0.28 0.32" rgb2="0.18 0.20 0.24"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="10 10" reflectance="0.15"/>
  </asset>

  <worldbody>
    <!-- Lighting Setup -->
    <light pos="0 0 5" dir="0 0 -1" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" directional="true"/>
    <light pos="5 -5 6" dir="-0.5 0.5 -1" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2"/>

    <!-- Large 20m x 20m Mobile Manipulation Testbed Ground Plane -->
    <geom name="floor" size="10 10 0.05" type="plane" material="groundplane" friction="1.2 0.005 0.0001"/>

    <!-- Cameras -->
    <camera name="isometric" pos="3.0 -3.0 2.2" xyaxes="0.707 0.707 0 -0.354 0.354 0.866"/>
    <camera name="side" pos="0 -3.5 1.5" xyaxes="1 0 0 0 0.371 0.928"/>
    <camera name="front" pos="3.5 0 1.5" xyaxes="0 1 0 -0.371 0 0.928"/>
    <camera name="top_down" pos="0 0 6.0" xyaxes="1 0 0 0 1 0"/>

    <!-- Dynamic Tracking Cameras following the Mobile Manipulator -->
    <camera name="tracking" mode="trackcom" target="base_link" pos="3.0 -3.0 2.0"/>
    <camera name="arm_closeup" mode="trackcom" target="shoulder_link" pos="1.5 -1.5 1.2"/>
  </worldbody>
</mujoco>
