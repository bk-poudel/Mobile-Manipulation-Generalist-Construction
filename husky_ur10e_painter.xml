<mujoco model="husky_ur10e_painter">
  <compiler angle="radian" autolimits="true"/>

  <option integrator="implicitfast"/>

  <default>
    <!-- Base class for Clearpath Husky mobile base -->
    <default class="husky">
      <geom friction="1.0 0.005 0.0001" solref="0.02 1" solimp="0.9 0.95 0.001"/>
      <joint damping="0.5" armature="0.01"/>

      <!-- Wheel properties: high lateral and longitudinal tire traction -->
      <default class="wheel">
        <joint axis="0 1 0" damping="0.8" armature="0.02"/>
        <geom type="cylinder" size="0.17775 0.05715" quat="0.7071068 0.7071068 0 0"
              friction="1.3 0.01 0.001" solref="0.015 1" solimp="0.9 0.95 0.001"/>
      </default>

      <!-- Collision shapes: grouped on layer 3 -->
      <default class="husky_collision">
        <geom group="3" contype="1" conaffinity="1" rgba="0.8 0.2 0.2 0.3"/>
      </default>

      <!-- Visual meshes: grouped on layer 2 (no contact calculation) -->
      <default class="husky_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
    </default>

    <!-- Base class for Universal Robots UR10e robotic arm -->
    <default class="ur10e">
      <material specular="0.5" shininess="0.25"/>
      <joint axis="0 1 0" range="-6.28319 6.28319" armature="0.1"/>
      <position ctrlrange="-6.2831 6.2831"/>
      <general biastype="affine" ctrlrange="-6.2831 6.2831" gainprm="5000" biasprm="0 -5000 -500"/>
      <default class="size4">
        <joint damping="10"/>
        <general forcerange="-330 330"/>
      </default>
      <default class="size3">
        <joint damping="5"/>
        <general forcerange="-150 150"/>
        <default class="size3_limited">
          <joint range="-3.1415 3.1415"/>
          <general ctrlrange="-3.1415 3.1415"/>
        </default>
      </default>
      <default class="size2">
        <joint damping="2"/>
        <general forcerange="-56 56"/>
      </default>
      <default class="ur_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="ur_collision">
        <geom type="capsule" group="3"/>
        <default class="eef_collision">
          <geom type="cylinder"/>
        </default>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>
  </default>

  <asset>
    <!-- Husky Visual Materials -->
    <material name="clearpath_yellow" rgba="0.95 0.76 0.05 1" specular="0.5" shininess="0.3"/>
    <material name="chassis_black" rgba="0.12 0.12 0.12 1" specular="0.25" shininess="0.15"/>
    <material name="wheel_rubber" rgba="0.18 0.18 0.18 1" specular="0.1" shininess="0.05"/>
    <material name="user_rail_dark" rgba="0.25 0.25 0.25 1" specular="0.4" shininess="0.3"/>
    <material name="bumper_black" rgba="0.2 0.2 0.2 1" specular="0.2" shininess="0.1"/>
    <material name="pedestal_dark" rgba="0.22 0.23 0.25 1" specular="0.5" shininess="0.3"/>
    <material name="pedestal_col" rgba="0.75 0.76 0.78 1" specular="0.6" shininess="0.4"/>

    <!-- UR10e Visual Materials -->
    <material class="ur10e" name="black" rgba="0.033 0.033 0.033 1"/>
    <material class="ur10e" name="jointgray" rgba="0.278 0.278 0.278 1"/>
    <material class="ur10e" name="linkgray" rgba="0.82 0.82 0.82 1"/>
    <material class="ur10e" name="urblue" rgba="0.49 0.678 0.8 1"/>

    <!-- Sander End-Effector Materials -->
    <material name="sandpaper" rgba="0.82 0.38 0.18 1" specular="0.1" shininess="0.05"/>
    <material name="rubber_pad" rgba="0.12 0.12 0.12 1" specular="0.2" shininess="0.1"/>

    <!-- Industrial Telescopic Column Materials -->
    <material name="machined_aluminum" rgba="0.82 0.84 0.86 1" specular="0.8" shininess="0.6"/>
    <material name="seal_amber" rgba="0.95 0.65 0.05 1" specular="0.6" shininess="0.4"/>
    <material name="linear_rail_steel" rgba="0.88 0.90 0.94 1" specular="0.95" shininess="0.9"/>
    <material name="status_green" rgba="0.10 0.90 0.30 1" emission="0.6" specular="0.8" shininess="0.5"/>

    <!-- Husky Meshes (from Huskyassets/meshes) -->
    <mesh name="base_link_mesh" file="Huskyassets/meshes/base_link.stl"/>
    <mesh name="top_plate_mesh" file="Huskyassets/meshes/top_plate.stl"/>
    <mesh name="wheel_mesh" file="Huskyassets/meshes/wheel.stl"/>
    <mesh name="bumper_mesh" file="Huskyassets/meshes/bumper.stl"/>
    <mesh name="user_rail_mesh" file="Huskyassets/meshes/user_rail.stl"/>

    <!-- UR10e Meshes (from assets) -->
    <mesh file="assets/base_0.obj"/>
    <mesh file="assets/base_1.obj"/>
    <mesh file="assets/shoulder_0.obj"/>
    <mesh file="assets/shoulder_1.obj"/>
    <mesh file="assets/shoulder_2.obj"/>
    <mesh file="assets/upperarm_0.obj"/>
    <mesh file="assets/upperarm_1.obj"/>
    <mesh file="assets/upperarm_2.obj"/>
    <mesh file="assets/upperarm_3.obj"/>
    <mesh file="assets/forearm_0.obj"/>
    <mesh file="assets/forearm_1.obj"/>
    <mesh file="assets/forearm_2.obj"/>
    <mesh file="assets/forearm_3.obj"/>
    <mesh file="assets/wrist1_0.obj"/>
    <mesh file="assets/wrist1_1.obj"/>
    <mesh file="assets/wrist1_2.obj"/>
    <mesh file="assets/wrist2_0.obj"/>
    <mesh file="assets/wrist2_1.obj"/>
    <mesh file="assets/wrist2_2.obj"/>
    <mesh file="assets/wrist3.obj"/>
    <!-- Industrial Spray Paint Gun Materials -->
    <material name="gun_metal" rgba="0.16 0.18 0.20 1" specular="0.7" shininess="0.5"/>
    <material name="gun_accent" rgba="0.08 0.55 0.92 1" specular="0.7" shininess="0.5"/>
    <material name="brass_fitting" rgba="0.85 0.70 0.22 1" specular="0.9" shininess="0.8"/>
    <material name="chrome_nozzle" rgba="0.88 0.90 0.94 1" specular="0.95" shininess="0.9"/>
    <material name="paint_mist" rgba="0.05 0.75 1.0 0.40" specular="0.1" shininess="0.05"/>
    <mesh name="spray_fan_mesh" file="assets/spray_fan.obj"/>
  </asset>

  <worldbody>
    <!-- Base link is centered on bottom plate at ground clearance z = 0.14493 m -->
    <body name="base_link" pos="0 0 0.14493" childclass="husky">
      <freejoint name="root"/>
      <inertial pos="-0.08748 -0.00085 0.09947" mass="33.455"
                fullinertia="0.6022 1.7386 2.0296 -0.02364 -0.1197 -0.001544"/>

      <!-- Husky Visual Elements -->
      <geom class="husky_visual" mesh="base_link_mesh" material="chassis_black"/>
      <geom class="husky_visual" mesh="top_plate_mesh" material="clearpath_yellow"/>
      <geom class="husky_visual" mesh="user_rail_mesh" pos="0.272 0 0.245" material="user_rail_dark"/>
      <geom class="husky_visual" mesh="bumper_mesh" pos="0.48 0 0.091" material="bumper_black"/>
      <geom class="husky_visual" mesh="bumper_mesh" pos="-0.48 0 0.091" euler="0 0 3.14159" material="bumper_black"/>

      <!-- Husky Collision Elements -->
      <geom name="chassis_col" class="husky_collision" type="box" size="0.40 0.21 0.11" pos="0 0 0.11"/>
      <geom name="front_bumper_col" class="husky_collision" type="box" size="0.04 0.26 0.015" pos="0.45 0 0.091"/>
      <geom name="rear_bumper_col" class="husky_collision" type="box" size="0.04 0.26 0.015" pos="-0.45 0 0.091"/>

      <!-- Standard Reference Sites -->
      <site name="imu" pos="0.19 0 0.149" size="0.01" rgba="1 0 0 1"/>
      <site name="base_footprint" pos="0 0 -0.14493" size="0.01" rgba="0 1 0 0.5"/>
      <site name="top_plate_center" pos="0 0 0.225" size="0.01" rgba="0 0 1 1"/>

      <!-- Husky 4-Wheel Assembly -->
      <body name="front_left_wheel_link" pos="0.256 0.2854 0.03282">
        <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="2.637" diaginertia="0.04411 0.02467 0.02467"/>
        <joint name="front_left_wheel" class="wheel"/>
        <geom class="husky_visual" mesh="wheel_mesh" material="wheel_rubber"/>
        <geom name="front_left_wheel_col" class="wheel"/>
      </body>

      <body name="front_right_wheel_link" pos="0.256 -0.2854 0.03282">
        <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="2.637" diaginertia="0.04411 0.02467 0.02467"/>
        <joint name="front_right_wheel" class="wheel"/>
        <geom class="husky_visual" mesh="wheel_mesh" material="wheel_rubber"/>
        <geom name="front_right_wheel_col" class="wheel"/>
      </body>

      <body name="rear_left_wheel_link" pos="-0.256 0.2854 0.03282">
        <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="2.637" diaginertia="0.04411 0.02467 0.02467"/>
        <joint name="rear_left_wheel" class="wheel"/>
        <geom class="husky_visual" mesh="wheel_mesh" material="wheel_rubber"/>
        <geom name="rear_left_wheel_col" class="wheel"/>
      </body>

      <body name="rear_right_wheel_link" pos="-0.256 -0.2854 0.03282">
        <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="2.637" diaginertia="0.04411 0.02467 0.02467"/>
        <joint name="rear_right_wheel" class="wheel"/>
        <geom class="husky_visual" mesh="wheel_mesh" material="wheel_rubber"/>
        <geom name="rear_right_wheel_col" class="wheel"/>
      </body>

      <!-- ========================================================================= -->
      <!-- Industrial Precision Telescopic Elevator Column (0.0 to 1.20 m Stroke)   -->
      <!-- Ewellix / Linak Style Modular Collaborative Robotic Lifting Column       -->
      <!-- ========================================================================= -->
      <body name="linear_lift_base" pos="0.05 0 0.225">
        <!-- 1. Heavy-Duty CNC Deck Mounting Base Flange -->
        <geom name="base_flange_plate" type="cylinder" size="0.148 0.008" pos="0 0 0.008" material="pedestal_dark" contype="0" conaffinity="0" group="2"/>
        <geom name="base_flange_chamfer" type="cylinder" size="0.138 0.004" pos="0 0 0.016" material="machined_aluminum" contype="0" conaffinity="0" group="2"/>
        <!-- Mounting Bolt Pattern -->
        <geom name="bolt_f1" type="cylinder" size="0.006 0.004" pos="0.125 0.05 0.018" material="linear_rail_steel" contype="0" conaffinity="0" group="2"/>
        <geom name="bolt_f2" type="cylinder" size="0.006 0.004" pos="0.125 -0.05 0.018" material="linear_rail_steel" contype="0" conaffinity="0" group="2"/>
        <geom name="bolt_r1" type="cylinder" size="0.006 0.004" pos="-0.125 0.05 0.018" material="linear_rail_steel" contype="0" conaffinity="0" group="2"/>
        <geom name="bolt_r2" type="cylinder" size="0.006 0.004" pos="-0.125 -0.05 0.018" material="linear_rail_steel" contype="0" conaffinity="0" group="2"/>
        <geom name="bolt_l1" type="cylinder" size="0.006 0.004" pos="0 0.135 0.018" material="linear_rail_steel" contype="0" conaffinity="0" group="2"/>
        <geom name="bolt_l2" type="cylinder" size="0.006 0.004" pos="0 -0.135 0.018" material="linear_rail_steel" contype="0" conaffinity="0" group="2"/>

        <!-- 2. Four Triangular Corner Structural Stiffener Gussets -->
        <geom name="gusset_front_l" type="box" size="0.012 0.024 0.040" pos="0.095 0.080 0.048" quat="0.92388 0 0 0.38268" material="pedestal_dark" contype="0" conaffinity="0" group="2"/>
        <geom name="gusset_front_r" type="box" size="0.012 0.024 0.040" pos="0.095 -0.080 0.048" quat="0.92388 0 0 -0.38268" material="pedestal_dark" contype="0" conaffinity="0" group="2"/>
        <geom name="gusset_rear_l" type="box" size="0.012 0.024 0.040" pos="-0.095 0.080 0.048" quat="0.38268 0 0 0.92388" material="pedestal_dark" contype="0" conaffinity="0" group="2"/>
        <geom name="gusset_rear_r" type="box" size="0.012 0.024 0.040" pos="-0.095 -0.080 0.048" quat="0.38268 0 0 -0.92388" material="pedestal_dark" contype="0" conaffinity="0" group="2"/>

        <!-- 3. Heavy-Duty Extruded Pillar Housing Profile (Matte Charcoal) -->
        <geom name="pillar_housing_main" type="box" size="0.102 0.102 0.048" pos="0 0 0.064" material="pedestal_dark" contype="0" conaffinity="0" group="2"/>
        <geom name="pillar_housing_chamfer" type="box" size="0.082 0.082 0.048" quat="0.92388 0 0 0.38268" pos="0 0 0.064" material="pedestal_dark" contype="0" conaffinity="0" group="2"/>
        <!-- Rear Drive Electronics & Motor Junction Enclosure -->
        <geom name="drive_junction_box" type="box" size="0.024 0.055 0.040" pos="-0.120 0 0.060" material="chassis_black" contype="0" conaffinity="0" group="2"/>
        <geom name="drive_status_led" type="sphere" size="0.005" pos="-0.145 0.035 0.080" material="status_green" contype="0" conaffinity="0" group="2"/>

        <!-- 4. Machined Aluminum Collar & Safety Wiper Seal -->
        <geom name="housing_top_collar" type="box" size="0.106 0.106 0.006" pos="0 0 0.114" material="machined_aluminum" contype="0" conaffinity="0" group="2"/>
        <geom name="housing_wiper_seal" type="box" size="0.100 0.100 0.003" pos="0 0 0.120" material="seal_amber" contype="0" conaffinity="0" group="2"/>

        <!-- Telescoping Elevator Carriage (Vertical Prismatic Joint) -->
        <body name="lift_carriage" pos="0 0 0.124">
          <inertial pos="0 0 0.08" mass="8.5" diaginertia="0.06 0.06 0.04"/>
          <!-- Prismatic Slide Joint along Z with 1.2m Stroke Range -->
          <joint name="prismatic_lift_joint" type="slide" axis="0 0 1" range="0.0 1.20" damping="60.0" armature="1.5"/>

          <!-- =============================================================== -->
          <!-- Sleek Full-Length Continuous Telescoping Mast Column (1.35m L)  -->
          <!-- Extends downward from carriage, ensuring ZERO mid-air gaps      -->
          <!-- =============================================================== -->
          <!-- 1. Central Extruded Structural Mast (Satin Anodized Aluminum) -->
          <geom name="mast_spine_main" type="box" size="0.076 0.076 0.675" pos="0 0 -0.675" material="pedestal_col" contype="0" conaffinity="0" group="2"/>
          <geom name="mast_spine_chamfer" type="box" size="0.060 0.060 0.675" quat="0.92388 0 0 0.38268" pos="0 0 -0.675" material="pedestal_col" contype="0" conaffinity="0" group="2"/>

          <!-- 2. Dual Precision Hardened Chrome Linear Guide Rails (Left & Right) -->
          <geom name="guide_rail_left" type="box" size="0.006 0.012 0.675" pos="0 0.080 -0.675" material="linear_rail_steel" contype="0" conaffinity="0" group="2"/>
          <geom name="guide_rail_right" type="box" size="0.006 0.012 0.675" pos="0 -0.080 -0.675" material="linear_rail_steel" contype="0" conaffinity="0" group="2"/>

          <!-- 3. Heavy-Duty Ground Precision Ballscrew Spindle (Front Center Channel) -->
          <geom name="ballscrew_spindle" type="cylinder" size="0.012 0.675" pos="0.066 0 -0.675" material="chrome_nozzle" contype="0" conaffinity="0" group="2"/>

          <!-- 4. Front & Rear Recessed Anodized Carbon Accent Channels -->
          <geom name="mast_accent_front" type="box" size="0.001 0.040 0.670" pos="0.077 0 -0.675" material="chassis_black" contype="0" conaffinity="0" group="2"/>
          <geom name="mast_accent_rear" type="box" size="0.001 0.040 0.670" pos="-0.077 0 -0.675" material="chassis_black" contype="0" conaffinity="0" group="2"/>

          <!-- 5. Carriage Head Mounting Plate & Recirculating Bearing Trucks -->
          <geom name="carriage_truck_l" type="box" size="0.022 0.020 0.028" pos="0 0.082 -0.014" material="gun_accent" contype="0" conaffinity="0" group="2"/>
          <geom name="carriage_truck_r" type="box" size="0.022 0.020 0.028" pos="0 -0.082 -0.014" material="gun_accent" contype="0" conaffinity="0" group="2"/>
          <!-- Heavy-Duty CNC Manipulator Base Flange Adapter -->
          <geom name="carriage_base_plate" type="cylinder" size="0.138 0.008" pos="0 0 0.004" material="pedestal_dark" contype="0" conaffinity="0" group="2"/>
          <geom name="carriage_beveled_ring" type="cylinder" size="0.128 0.004" pos="0 0 0.010" material="machined_aluminum" contype="0" conaffinity="0" group="2"/>
          <!-- Cable Carrier Drag Chain Mounting Bracket -->
          <geom name="cable_carrier_bracket" type="box" size="0.030 0.042 0.018" pos="-0.096 0 0.008" material="chassis_black" contype="0" conaffinity="0" group="2"/>

          <!-- Universal Robots UR10e 6-DOF Manipulator Assembly (Mounted on Lift Carriage) -->
          <body name="ur_base" pos="0 0 0.012" quat="0 0 0 -1" childclass="ur10e">
          <inertial mass="4.0" pos="0 0 0" diaginertia="0.0061063308908 0.0061063308908 0.01125"/>
          <geom mesh="base_0" material="black" class="ur_visual"/>
          <geom mesh="base_1" material="jointgray" class="ur_visual"/>

          <body name="shoulder_link" pos="0 0 0.181">
            <inertial pos="0 0 0" mass="7.778" diaginertia="0.0314743 0.0314743 0.0218756"/>
            <joint name="shoulder_pan_joint" class="size4" axis="0 0 1"/>
            <geom mesh="shoulder_0" material="urblue" class="ur_visual"/>
            <geom mesh="shoulder_1" material="black" class="ur_visual"/>
            <geom mesh="shoulder_2" material="jointgray" class="ur_visual"/>
            <geom class="ur_collision" size="0.078 0.05" pos="0 0 -0.02"/>

            <body name="upper_arm_link" pos="0 0.176 0" quat="1 0 1 0">
              <inertial pos="0 0 0.3065" mass="12.93" diaginertia="0.423074 0.423074 0.0363656"/>
              <joint name="shoulder_lift_joint" class="size4"/>
              <geom mesh="upperarm_0" material="black" class="ur_visual"/>
              <geom mesh="upperarm_1" material="jointgray" class="ur_visual"/>
              <geom mesh="upperarm_2" material="urblue" class="ur_visual"/>
              <geom mesh="upperarm_3" material="linkgray" class="ur_visual"/>
              <geom class="ur_collision" pos="0 -0.05 0" quat="1 1 0 0" size="0.078 0.08"/>
              <geom class="ur_collision" size="0.06 0.3" pos="0 0 0.3"/>

              <body name="forearm_link" pos="0 -0.137 0.613">
                <inertial pos="0 0 0.2855" mass="3.87" diaginertia="0.11059 0.11059 0.0108844"/>
                <joint name="elbow_joint" class="size3_limited"/>
                <geom mesh="forearm_0" material="urblue" class="ur_visual"/>
                <geom mesh="forearm_1" material="black" class="ur_visual"/>
                <geom mesh="forearm_2" material="jointgray" class="ur_visual"/>
                <geom mesh="forearm_3" material="linkgray" class="ur_visual"/>
                <geom class="ur_collision" pos="0 0.08 0" quat="1 1 0 0" size="0.058 0.065"/>
                <geom class="ur_collision" size="0.043 0.28" pos="0 0 0.29"/>

                <body name="wrist_1_link" pos="0 0 0.571" quat="1 0 1 0">
                  <inertial pos="0 0.135 0" quat="0.5 0.5 -0.5 0.5" mass="1.96"
                    diaginertia="0.0055125 0.00510825 0.00510825"/>
                  <joint name="wrist_1_joint" class="size2"/>
                  <geom mesh="wrist1_0" material="black" class="ur_visual"/>
                  <geom mesh="wrist1_1" material="urblue" class="ur_visual"/>
                  <geom mesh="wrist1_2" material="jointgray" class="ur_visual"/>
                  <geom class="ur_collision" pos="0 0.06 0" quat="1 1 0 0" size="0.05 0.07"/>

                  <body name="wrist_2_link" pos="0 0.135 0">
                    <inertial pos="0 0 0.12" quat="0.5 0.5 -0.5 0.5" mass="1.96"
                      diaginertia="0.0055125 0.00510825 0.00510825"/>
                    <joint name="wrist_2_joint" axis="0 0 1" class="size2"/>
                    <geom mesh="wrist2_0" material="black" class="ur_visual"/>
                    <geom mesh="wrist2_1" material="urblue" class="ur_visual"/>
                    <geom mesh="wrist2_2" material="jointgray" class="ur_visual"/>
                    <geom class="ur_collision" size="0.046 0.065" pos="0 0 0.05"/>
                    <geom class="ur_collision" pos="0 0.028 0.12" quat="1 1 0 0" size="0.046 0.043"/>

                    <body name="wrist_3_link" pos="0 0 0.12">
                      <inertial pos="0 0.092 0" quat="0 1 -1 0" mass="0.202"
                        diaginertia="0.000204525 0.000144346 0.000144346"/>
                      <joint name="wrist_3_joint" class="size2"/>
                      <geom material="linkgray" mesh="wrist3" class="ur_visual"/>
                      <geom class="eef_collision" pos="0 0.097 0" quat="1 1 0 0" size="0.046 0.02"/>
                      <site name="attachment_site" pos="0 0.1 0" quat="-1 1 0 0"/>

                      <!-- Industrial Airless Spray Painting Gun End-Effector -->
                      <body name="paint_gun_mount" pos="0 0.1 0" quat="-1 1 0 0">
                        <inertial pos="0 0 0.045" mass="0.45" diaginertia="0.0006 0.0007 0.0010"/>

                        <!-- Flange mounting adapter plate -->
                        <geom name="gun_adapter" type="cylinder" pos="0 0 0.008" size="0.045 0.008" material="jointgray" contype="0" conaffinity="0"/>

                        <!-- Main spray gun body / manifold -->
                        <geom name="gun_body" type="box" pos="0 0 0.038" size="0.024 0.022 0.022" material="gun_metal" contype="0" conaffinity="0"/>
                        <geom name="gun_accent_band" type="cylinder" pos="0 0 0.060" size="0.025 0.003" material="gun_accent" contype="0" conaffinity="0"/>

                        <!-- Pneumatic trigger cylinder actuator on top -->
                        <geom name="pneumatic_actuator" type="cylinder" pos="0 0.028 0.038" size="0.012 0.018" material="gun_metal" contype="0" conaffinity="0"/>

                        <!-- High-pressure fluid feed inlet & brass fitting block below -->
                        <geom name="fluid_fitting_block" type="box" pos="0 -0.026 0.032" size="0.012 0.012 0.012" material="brass_fitting" contype="0" conaffinity="0"/>
                        <geom name="paint_hose_coupler" type="cylinder" pos="0 -0.038 0.032" quat="0.7071 0.7071 0 0" size="0.007 0.012" material="brass_fitting" contype="0" conaffinity="0"/>

                        <!-- Spray gun nozzle barrel -->
                        <geom name="gun_barrel" type="cylinder" pos="0 0 0.075" size="0.014 0.012" material="gun_metal" contype="0" conaffinity="0"/>

                        <!-- Atomizing air cap & spray tip nozzle (brass/chrome) -->
                        <geom name="nozzle_air_cap" type="cylinder" pos="0 0 0.092" size="0.012 0.006" material="chrome_nozzle" contype="0" conaffinity="0"/>
                        <!-- Atomizing air horns (twin shaping jets for flat fan pattern) -->
                        <geom name="air_horn_left"  type="cylinder" pos="0  0.010 0.096" size="0.0025 0.004" material="brass_fitting" contype="0" conaffinity="0"/>
                        <geom name="air_horn_right" type="cylinder" pos="0 -0.010 0.096" size="0.0025 0.004" material="brass_fitting" contype="0" conaffinity="0"/>

                        <!-- Tool Center Point (TCP) site at front nozzle orifice -->
                        <site name="tcp" pos="0 0 0.096" size="0.006" rgba="0 1 0 1"/>
                        <site name="paint_tcp" pos="0 0 0.096" size="0.006" rgba="0 0.8 1 1"/>

                        <!-- Atomized Spray Fan Cone: Semi-transparent visual projection hitting the wall -->
                        <geom name="spray_cone_vis" type="mesh" mesh="spray_fan_mesh" pos="0 0 0.096"
                              material="paint_mist" contype="0" conaffinity="0"/>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
    </body>
  </worldbody>

  <!-- Actuators: 4 Wheel Velocity Drives + 1 Telescopic Linear Lift Motor + 6 Arm Direct Torque Motors -->
  <actuator>
    <!-- Husky 4-Wheel Skid-Steer Velocity Actuators -->
    <velocity name="front_left_wheel_ctrl" joint="front_left_wheel" kv="45" ctrlrange="-20 20" forcerange="-65 65"/>
    <velocity name="front_right_wheel_ctrl" joint="front_right_wheel" kv="45" ctrlrange="-20 20" forcerange="-65 65"/>
    <velocity name="rear_left_wheel_ctrl" joint="rear_left_wheel" kv="45" ctrlrange="-20 20" forcerange="-65 65"/>
    <velocity name="rear_right_wheel_ctrl" joint="rear_right_wheel" kv="45" ctrlrange="-20 20" forcerange="-65 65"/>

    <!-- Telescopic Prismatic Lift Linear Motor (Vertical Force +/- 1500 N) -->
    <motor name="lift_motor" joint="prismatic_lift_joint" ctrlrange="-1500 1500"/>

    <!-- UR10e 6-DOF Direct Torque Motors for Hybrid Position/Force Control -->
    <motor name="shoulder_pan" joint="shoulder_pan_joint" ctrlrange="-330 330"/>
    <motor name="shoulder_lift" joint="shoulder_lift_joint" ctrlrange="-330 330"/>
    <motor name="elbow" joint="elbow_joint" ctrlrange="-150 150"/>
    <motor name="wrist_1" joint="wrist_1_joint" ctrlrange="-56 56"/>
    <motor name="wrist_2" joint="wrist_2_joint" ctrlrange="-56 56"/>
    <motor name="wrist_3" joint="wrist_3_joint" ctrlrange="-56 56"/>
  </actuator>

  <!-- Sensors for Recoil Force Regulation, Pose, Lift & Telemetry -->
  <sensor>
    <jointpos name="lift_pos" joint="prismatic_lift_joint"/>
    <jointvel name="lift_vel" joint="prismatic_lift_joint"/>
    <force name="tcp_force_sensor" site="tcp"/>
    <torque name="tcp_torque_sensor" site="tcp"/>
    <accelerometer name="imu_accel" site="imu"/>
    <gyro name="imu_gyro" site="imu"/>
    <jointvel name="front_left_wheel_vel" joint="front_left_wheel"/>
    <jointvel name="front_right_wheel_vel" joint="front_right_wheel"/>
    <jointvel name="rear_left_wheel_vel" joint="rear_left_wheel"/>
    <jointvel name="rear_right_wheel_vel" joint="rear_right_wheel"/>
    <framepos name="tcp_pos" objtype="site" objname="tcp"/>
    <framequat name="tcp_quat" objtype="site" objname="tcp"/>
    <framelinvel name="tcp_vel" objtype="site" objname="tcp"/>
  </sensor>
</mujoco>
